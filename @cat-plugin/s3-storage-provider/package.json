{
  "name": "@cat-plugin/s3-storage-provider",
  "version": "0.1.0",
  "keywords": [
    "cat",
    "plugins",
    "types",
    "typescript"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "manifest.json",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./manifest.json": "./manifest.json",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "format": "node ../../tooling/oxlint/run.ts format",
    "lint": "node ../../tooling/oxlint/run.ts lint",
    "pack:artifact": "node ../../scripts/pack-public-package.ts",
    "test": "vitest run --reporter=agent --silent=passed-only --passWithNoTests",
    "test:unit": "vitest run --reporter=agent --silent=passed-only --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/lib-storage": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cat/plugin-core": "link:../../packages/plugin-core",
    "@cat/shared": "link:../../packages/shared",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@cat/plugin-core": "workspace:*"
  }
}
