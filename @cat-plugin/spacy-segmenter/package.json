{
  "name": "@cat-plugin/spacy-segmenter",
  "version": "0.1.0",
  "keywords": [
    "cat",
    "nlp",
    "plugins",
    "spacy",
    "typescript"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "manifest.json",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./manifest.json": "./manifest.json",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --type-aware --config ../../oxlint.config.ts --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --fix --format=unix --type-aware --config ../../oxlint.config.ts --no-error-on-unmatched-pattern .",
    "pack:artifact": "node ../../scripts/pack-public-package.ts",
    "test": "vitest run --reporter=agent --silent=passed-only --passWithNoTests",
    "test:unit": "vitest run --reporter=agent --silent=passed-only --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "undici": "catalog:peer",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cat/plugin-core": "link:../../packages/plugin-core",
    "@cat/shared": "link:../../packages/shared",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@cat/plugin-core": "workspace:*"
  }
}
