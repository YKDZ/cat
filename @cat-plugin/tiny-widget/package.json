{
  "name": "@cat-plugin/tiny-widget",
  "version": "0.1.0",
  "keywords": [
    "cat",
    "plugins",
    "types",
    "typescript"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "manifest.json",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./manifest.json": "./manifest.json",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "format:check": "cd ../.. && oxfmt --list-different --config oxfmt.config.ts @cat-plugin/tiny-widget",
    "format:write": "cd ../.. && oxfmt --write --config oxfmt.config.ts @cat-plugin/tiny-widget",
    "lint": "cd ../.. && oxlint --quiet --format=unix --type-aware --config oxlint.config.ts --no-error-on-unmatched-pattern @cat-plugin/tiny-widget",
    "lint:fix": "cd ../.. && oxlint --fix --format=unix --type-aware --config oxlint.config.ts --no-error-on-unmatched-pattern @cat-plugin/tiny-widget",
    "pack:artifact": "node ../../scripts/pack-public-package.ts",
    "test": "vitest run --reporter=agent --silent=passed-only --passWithNoTests",
    "test:unit": "vitest run --reporter=agent --silent=passed-only --passWithNoTests",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json"
  },
  "devDependencies": {
    "@cat/plugin-core": "link:../../packages/plugin-core",
    "@vitejs/plugin-vue": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "@cat/plugin-core": "workspace:*"
  }
}
