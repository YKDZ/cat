{
  "name": "@cat-plugin/totp-mfa-provider",
  "version": "0.1.0",
  "keywords": [
    "cat",
    "plugins"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "manifest.json",
    "package.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js"
      },
      "./manifest.json": "./manifest.json",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vite build",
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --type-aware --config ../../oxlint.config.ts --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --fix --format=unix --type-aware --config ../../oxlint.config.ts --no-error-on-unmatched-pattern .",
    "pack:artifact": "node ../../scripts/pack-package-artifact.ts",
    "test": "vitest run --reporter=agent --silent=passed-only --passWithNoTests",
    "test:unit": "vitest run --reporter=agent --silent=passed-only --passWithNoTests",
    "typecheck": "pnpm --workspace-root exec tsc --build ./@cat-plugin/totp-mfa-provider/tsconfig.json --noEmit --pretty false && vue-tsc --noEmit --pretty false -p tsconfig.app.json"
  },
  "dependencies": {
    "qrcode": "catalog:",
    "speakeasy": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cat/plugin-core": "link:../../packages/plugin-core",
    "@cat/shared": "link:../../packages/shared",
    "@cat/typescript-config": "link:../../packages/typescript-config",
    "@types/qrcode": "catalog:",
    "@types/speakeasy": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/tsconfig": "catalog:",
    "hono": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "@cat/plugin-core": "workspace:*"
  }
}
