{
  "$schema": "../../plugin-core/manifest-schema.json",
  "id": "spacy-language-analyzer",
  "version": "0.1.0",
  "configVersion": "1",
  "entry": "dist/index.js",
  "services": [
    {
      "id": "spacy-language-analyzer",
      "type": "LANGUAGE_ANALYZER"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "required": ["serverUrl"],
    "properties": {
      "serverUrl": {
        "type": "string",
        "default": "http://localhost:8000",
        "description": "spaCy REST server URL"
      },
      "timeout": {
        "type": "number",
        "default": 30000,
        "description": "Request timeout in milliseconds"
      },
      "languageIds": {
        "type": "array",
        "description": "Canonical BCP-47 language IDs expected from the provisioned runtime.",
        "default": ["en", "zh-Hans"],
        "items": { "type": "string" },
        "minItems": 1,
        "uniqueItems": true
      }
    }
  }
}
