{
  "name": "@cat/eval",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "eval": "node --conditions=source src/cli.ts",
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --type-aware --config ../../oxlint.config.ts --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --fix --format=unix --type-aware --config ../../oxlint.config.ts --no-error-on-unmatched-pattern .",
    "test": "vitest run --reporter=agent --silent=passed-only --config vitest.config.ts",
    "test:unit": "vitest run --reporter=agent --silent=passed-only --config vitest.config.ts",
    "typecheck": "pnpm --workspace-root exec tsc --noEmit --pretty false -p apps/eval/tsconfig.json"
  },
  "dependencies": {
    "@cat/agent": "link:../../packages/agent",
    "@cat/agent-tools": "link:../../packages/agent-tools",
    "@cat/db": "link:../../packages/db",
    "@cat/domain": "link:../../packages/domain",
    "@cat/operations": "link:../../packages/operations",
    "@cat/permissions": "link:../../packages/permissions",
    "@cat/plugin-core": "link:../../packages/plugin-core",
    "@cat/seed": "link:../../packages/seed",
    "@cat/server-shared": "link:../../packages/server-shared",
    "@cat/shared": "link:../../packages/shared",
    "@cat/test-utils": "link:../../packages/test-utils",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/exporter-metrics-otlp-http": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "commander": "catalog:",
    "js-yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cat/typescript-config": "link:../../packages/typescript-config",
    "@types/js-yaml": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
