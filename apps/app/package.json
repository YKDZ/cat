{
  "name": "@cat/app",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "files": [
    "dist",
    "drizzle",
    "locales",
    "node_modules",
    "package.json",
    "default-plugins.json",
    "plugins",
    "scripts"
