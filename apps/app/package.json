{
  "name": "@cat/app",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "files": [
    "dist",
    "drizzle",
    "locales",
    "node_modules",
    "package.json",
    "default-plugins.json",
    "plugins",
    "scripts"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "vike build",
    "copy-drizzle": "node scripts/copy-drizzle.ts",
    "dev": "node scripts/dev.ts",
    "docker:build": "docker buildx build ../../ -f Dockerfile --target standalone -t ykdz/cat:latest",
    "docker:build:runtime": "docker buildx build ../../ -f Dockerfile --target runtime -t ykdz/cat:latest-runtime",
    "docker:build:standalone": "docker buildx build ../../ -f Dockerfile --target standalone -t ykdz/cat:latest",
    "docker:push": "docker push ykdz/cat",
    "format": "node ../../tooling/oxlint/run.ts format",
    "lint": "node ../../tooling/oxlint/run.ts lint",
    "preview": "node scripts/copy-drizzle.ts && cross-env NODE_ENV=production node dist/server/index.mjs",
    "test": "vitest run --reporter=agent --silent=passed-only --config vitest.config.ts",
    "test:integration": "vitest run --reporter=agent --silent=passed-only --config vitest.config.ts --exclude '**/*.spec.ts' --no-file-parallelism --passWithNoTests",
    "test:unit": "vitest run --reporter=agent --silent=passed-only --config vitest.config.ts --exclude '**/*.test.ts' --no-file-parallelism --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
