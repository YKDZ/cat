  "type": "module",
  "imports": {
    "#e2e-hmr-application": "./src/e2e/hmr-application-default.vue",
    "#/*": "./src/*"
  },
  "scripts": {
    "bootstrap-only": "node dist/bootstrap-only/bootstrap-only-cli.js",
    "bootstrap:local": "pnpm --filter @cat/db drizzle:push && pnpm build && node scripts/bootstrap-local.mjs",
    "build": "vike build && vite build --config vite.bootstrap.config.ts",
    "build:bootstrap-only": "vite build --config vite.bootstrap.config.ts",
    "copy-drizzle": "node scripts/copy-drizzle.ts",
    "dev": "node scripts/dev.ts",
    "format:check": "cd ../.. && oxfmt --list-different --config oxfmt.config.ts apps/app",
    "format:write": "cd ../.. && oxfmt --write --config oxfmt.config.ts apps/app",
    "lint": "cd ../.. && oxlint --quiet --format=unix --type-aware --config oxlint.config.ts --no-error-on-unmatched-pattern apps/app",
    "lint:fix": "cd ../.. && oxlint --fix --format=unix --type-aware --config oxlint.config.ts --no-error-on-unmatched-pattern apps/app",
    "test": "vitest run --reporter=agent --silent=passed-only --config vitest.config.ts",
    "test:integration": "vitest run --reporter=agent --silent=passed-only --config vitest.config.ts --exclude '**/*.spec.ts' --no-file-parallelism --passWithNoTests",
    "test:unit": "vitest run --reporter=agent --silent=passed-only --config vitest.config.ts --exclude '**/*.test.ts' --no-file-parallelism --passWithNoTests",
    "typecheck": "pnpm --workspace-root exec tsc --build apps/app/tsconfig.json --noEmit --pretty false && vue-tsc --noEmit --pretty false -p tsconfig.app.json"
  },
