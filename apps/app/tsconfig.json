{
  "extends": "../../tsconfig.vue.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "importHelpers": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/globals", "vitest/importMeta"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "scripts/**/*.ts",
    "vite.config.ts",
    "vite.bootstrap.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["dist", "out-tsc"]
}
