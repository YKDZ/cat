{
  "extends": [
    "@vue/tsconfig/tsconfig.dom.json",
    "@cat/typescript-config/bundler.json"
  ],
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "rootDir": ".",
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.test.tsbuildinfo",
    "types": ["node", "vite/client", "vitest/globals", "vitest/importMeta"]
  },
  "include": [
    "scripts/**/*.spec.ts",
    "scripts/**/*.test.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "vitest.config.ts"
  ]
}
