# For local host runs, point to the published ports from
# `apps/app/compose.local.yaml`. Inside the dev container, replace
# `localhost` with `172.17.0.1`.
DATABASE_URL="postgresql://user:pass@localhost:25432/cat?schema=public"
REDIS_URL="redis://:cat-local-redis@127.0.0.1:26379"
SPACY_SERVER_URL="http://127.0.0.1:28000"

PORT=3000
