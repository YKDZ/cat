{
  "extends": [
    "@vue/tsconfig/tsconfig.dom.json",
    "@cat/typescript-config/bundler.json"
  ],
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.app.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/.vitepress/**/*.ts",
    "src/**/*.vue",
    "src/.vitepress/**/*.vue"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
