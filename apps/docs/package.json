{
  "name": "@cat/docs",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "vitepress build src",
    "dev": "vitepress dev src",
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --type-aware --config ../../oxlint.config.ts --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --fix --format=unix --type-aware --config ../../oxlint.config.ts --no-error-on-unmatched-pattern .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@tailwindcss/vite": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/mdi": "catalog:",
    "@iconify/tailwind4": "catalog:",
    "@mermaid-js/mermaid-zenuml": "catalog:",
    "@vueuse/core": "catalog:",
    "mermaid": "catalog:",
    "vitepress": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
