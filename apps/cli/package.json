{
  "name": "@cat/cli",
  "version": "0.0.1",
  "private": true,
  "bin": {
    "cat-cli": "./src/cli.ts"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "format": "node ../../tooling/oxlint/run.ts format",
    "generate:routes": "node scripts/generate-routes.ts",
    "lint": "node ../../tooling/oxlint/run.ts lint",
    "test": "vitest run --reporter=agent --silent=passed-only --config package.json",
    "test:unit": "vitest run --reporter=agent --silent=passed-only --config package.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@cat/app-api": "link:../../packages/app-api",
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
