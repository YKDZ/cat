{
  "name": "@cat/cli",
  "version": "0.0.1",
  "private": true,
  "bin": {
    "cat-cli": "./src/cli.ts"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "generate:routes": "node scripts/generate-routes.ts",
    "lint": "oxlint --quiet --format=unix --type-aware --config ../../oxlint.config.ts --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --fix --format=unix --type-aware --config ../../oxlint.config.ts --no-error-on-unmatched-pattern .",
    "test": "vitest run --reporter=agent --silent=passed-only --config package.json",
    "test:unit": "vitest run --reporter=agent --silent=passed-only --config package.json",
    "typecheck": "pnpm --workspace-root exec tsc --noEmit -p apps/cli/tsconfig.json"
  },
  "dependencies": {
    "@cat/app-api": "link:../../packages/app-api",
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
