{
  "name": "@cat/app-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./tests/*"
  },
  "scripts": {
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --type-aware --config ../../oxlint.config.ts --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --fix --format=unix --type-aware --config ../../oxlint.config.ts --no-error-on-unmatched-pattern .",
    "test:e2e": "node test-e2e.ts",
    "test:unit": "vitest run --reporter=agent --silent=passed-only --config vitest.config.ts --passWithNoTests",
    "typecheck": "pnpm --workspace-root exec tsc --noEmit -p apps/app-e2e/tsconfig.json"
  },
  "devDependencies": {
    "@cat/db": "link:../../packages/db",
    "@cat/domain": "link:../../packages/domain",
    "@cat/seed": "link:../../packages/seed",
    "@cat/shared": "link:../../packages/shared",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "dotenv": "catalog:",
    "pg": "catalog:",
    "redis": "catalog:",
    "vitest": "catalog:"
  }
}
