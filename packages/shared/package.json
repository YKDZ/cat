{
  "name": "@cat/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas, type definitions, and utility functions",
  "keywords": [
    "cat",
    "plugins",
    "types",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --type-aware --config ../../oxlint.config.ts --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --fix --format=unix --type-aware --config ../../oxlint.config.ts --no-error-on-unmatched-pattern .",
    "test": "vitest run --exclude '**/*.test.ts' --reporter=agent --silent=passed-only --passWithNoTests",
    "test:integration": "vitest run --exclude '**/*.spec.ts' --no-file-parallelism --reporter=agent --silent=passed-only --passWithNoTests",
    "test:unit": "vitest run --exclude '**/*.test.ts' --reporter=agent --silent=passed-only --passWithNoTests",
    "typecheck": "pnpm --workspace-root exec tsc --noEmit -p packages/shared/tsconfig.json"
  },
  "dependencies": {
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
