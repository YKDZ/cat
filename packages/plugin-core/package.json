{
  "name": "@cat/plugin-core",
  "version": "0.1.0",
  "description": "Plugin system core: service registry, component registry, discovery",
  "keywords": [
    "cat",
    "plugins",
    "types",
    "typescript"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./client": {
      "source": "./src/client/index.ts",
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts"
    }
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "imports": {},
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "import": "./dist/client.js"
      }
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.lib.json",
    "format": "node ../../tooling/oxlint/run.ts format",
    "lint": "node ../../tooling/oxlint/run.ts lint",
    "pack:artifact": "node ../../scripts/pack-public-package.ts",
    "test": "vitest run --reporter=agent --silent=passed-only --config vitest.config.ts",
    "test:unit": "vitest run --reporter=agent --silent=passed-only --config vitest.config.ts --exclude '**/*.test.ts' --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "cldr-core": "catalog:",
    "hono": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cat/domain": "link:../domain",
    "@cat/shared": "link:../shared",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "dompurify": "catalog:peer",
    "vue": "catalog:"
  }
}
