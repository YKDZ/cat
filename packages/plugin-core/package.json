{
  "name": "@cat/plugin-core",
  "version": "0.1.0",
  "description": "Plugin system core: service registry, component registry, discovery",
  "keywords": [
    "cat",
    "plugins",
    "types",
    "typescript"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "source": "./src/client/index.ts",
      "development": "./src/client/index.ts",
      "types": "./src/client/index.ts",
      "import": "./dist/client.js"
    }
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "imports": {},
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "import": "./dist/client.js"
      }
    }
  },
  "scripts": {
    "build": "vite build && pnpm --workspace-root exec tsc --pretty false -p packages/plugin-core/tsconfig.lib.json",
    "format:check": "cd ../.. && oxfmt --list-different --config oxfmt.config.ts packages/plugin-core",
    "format:write": "cd ../.. && oxfmt --write --config oxfmt.config.ts packages/plugin-core",
    "lint": "cd ../.. && oxlint --quiet --format=unix --type-aware --config oxlint.config.ts --no-error-on-unmatched-pattern packages/plugin-core",
    "lint:fix": "cd ../.. && oxlint --fix --format=unix --type-aware --config oxlint.config.ts --no-error-on-unmatched-pattern packages/plugin-core",
    "pack:artifact": "node ../../scripts/pack-package-artifact.ts",
    "test": "vitest run --reporter=agent --silent=passed-only --config vitest.config.ts",
    "test:unit": "vitest run --reporter=agent --silent=passed-only --config vitest.config.ts --exclude '**/*.test.ts' --passWithNoTests",
    "typecheck": "pnpm --workspace-root exec tsc --build packages/plugin-core/tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "cldr-core": "catalog:",
    "hono": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cat/domain": "link:../domain",
    "@cat/shared": "link:../shared",
    "@cat/typescript-config": "link:../typescript-config",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "dompurify": "catalog:peer",
    "vue": "catalog:"
  }
}
