{
  "extends": "@cat/typescript-config/bundler.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM"],
    "rootDir": "src",
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.app.tsbuildinfo",
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
