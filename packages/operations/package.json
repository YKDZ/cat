{
  "name": "@cat/operations",
  "version": "0.1.0",
  "private": true,
  "description": "Operations layer: business workflows composing domain operations",
  "keywords": [
    "cat",
    "operations",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --type-aware --config ../../oxlint.config.ts --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --fix --format=unix --type-aware --config ../../oxlint.config.ts --no-error-on-unmatched-pattern .",
    "test": "vitest run --reporter=agent --silent=passed-only --exclude '**/*.test.ts' --passWithNoTests",
    "test:integration": "vitest run --reporter=agent --silent=passed-only --exclude '**/*.spec.ts' --no-file-parallelism --passWithNoTests",
    "test:unit": "vitest run --reporter=agent --silent=passed-only --exclude '**/*.test.ts' --passWithNoTests",
    "typecheck": "pnpm --workspace-root exec tsc --noEmit --pretty false -p packages/operations/tsconfig.json"
  },
  "dependencies": {
    "@cat/core": "link:../core",
    "@cat/domain": "link:../domain",
    "@cat/message": "link:../message",
    "@cat/permissions": "link:../permissions",
    "@cat/plugin-core": "link:../plugin-core",
    "@cat/server-shared": "link:../server-shared",
    "@cat/shared": "link:../shared",
    "@cat/vcs": "link:../vcs",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cat/test-utils": "link:../test-utils",
    "@cat/typescript-config": "link:../typescript-config",
    "vitest": "catalog:"
  }
}
