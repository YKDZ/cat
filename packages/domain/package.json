{
  "name": "@cat/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Domain layer: CQRS Commands and Queries, core business logic",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./events": "./src/events/index.ts",
    "./capabilities": "./src/capabilities/index.ts",
    "./cache": "./src/cache/index.ts"
  },
  "scripts": {
    "format": "node ../../tooling/oxlint/run.ts format",
    "lint": "node ../../tooling/oxlint/run.ts lint",
    "test": "vitest run --reporter=agent --silent=passed-only --exclude '**/*.test.ts' --passWithNoTests",
    "test:integration": "vitest run --reporter=agent --silent=passed-only --exclude '**/*.spec.ts' --no-file-parallelism --passWithNoTests",
    "test:unit": "vitest run --reporter=agent --silent=passed-only --exclude '**/*.test.ts' --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@cat/core": "link:../core",
    "@cat/db": "link:../db",
    "@cat/shared": "link:../shared",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "vitest": "catalog:"
  }
}
