{
  "name": "@cat/app-api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./readiness": "./src/handler/readiness.ts",
    "./orpc/router": "./src/orpc/router.ts",
    "./context": "./src/utils/context.ts"
  },
  "scripts": {
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --type-aware --config ../../oxlint.config.ts --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --fix --format=unix --type-aware --config ../../oxlint.config.ts --no-error-on-unmatched-pattern .",
    "test": "vitest run --reporter=agent --silent=passed-only --config vitest.config.ts --exclude '**/*.test.ts' --passWithNoTests",
    "test:integration": "vitest run --reporter=agent --silent=passed-only --config vitest.config.ts --exclude '**/*.spec.ts' --no-file-parallelism --passWithNoTests",
    "test:unit": "vitest run --reporter=agent --silent=passed-only --config vitest.config.ts --exclude '**/*.test.ts' --passWithNoTests",
    "typecheck": "pnpm --workspace-root exec tsc --noEmit --pretty false -p packages/app-api/tsconfig.json"
  },
  "dependencies": {
    "@cat/agent": "link:../agent",
    "@cat/agent-tools": "link:../agent-tools",
    "@cat/auth": "link:../auth",
    "@cat/domain": "link:../domain",
    "@cat/message": "link:../message",
    "@cat/operations": "link:../operations",
    "@cat/permissions": "link:../permissions",
    "@cat/plugin-core": "link:../plugin-core",
    "@cat/server-shared": "link:../server-shared",
    "@cat/shared": "link:../shared",
    "@cat/vcs": "link:../vcs",
    "@cat/workflow": "link:../workflow",
    "@hono/node-ws": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/experimental-pino": "catalog:",
    "@orpc/server": "catalog:",
    "hono": "catalog:",
    "telefunc": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cat/test-utils": "link:../test-utils",
    "@cat/typescript-config": "link:../typescript-config",
    "vitest": "catalog:"
  }
}
