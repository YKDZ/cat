{
  "name": "@cat/ui",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "format:check": "cd ../.. && oxfmt --list-different --config oxfmt.config.ts packages/ui",
    "format:write": "cd ../.. && oxfmt --write --config oxfmt.config.ts packages/ui",
    "lint": "cd ../.. && oxlint --quiet --format=unix --type-aware --config oxlint.config.ts --no-error-on-unmatched-pattern packages/ui",
    "lint:fix": "cd ../.. && oxlint --fix --format=unix --type-aware --config oxlint.config.ts --no-error-on-unmatched-pattern packages/ui",
    "test": "vitest run --reporter=agent --silent=passed-only --config vitest.config.ts",
    "test:unit": "vitest run --reporter=agent --silent=passed-only --config vitest.config.ts --passWithNoTests",
    "typecheck": "pnpm --workspace-root exec tsc --build packages/ui/tsconfig.json --noEmit --pretty false && vue-tsc --noEmit --pretty false -p tsconfig.json"
  },
  "dependencies": {
    "@lucide/vue": "catalog:",
    "@tanstack/vue-table": "catalog:",
    "@vue-flow/controls": "catalog:",
    "@vue-flow/core": "catalog:",
    "@vue-flow/minimap": "catalog:",
    "@vueuse/core": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "elkjs": "catalog:",
    "reka-ui": "catalog:",
    "tailwind-merge": "catalog:",
    "vee-validate": "catalog:",
    "vike-vue": "catalog:",
    "vue": "catalog:",
    "vue-sonner": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cat/typescript-config": "link:../typescript-config",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vue/tsconfig": "catalog:",
    "happy-dom": "catalog:",
    "shadcn-vue": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
