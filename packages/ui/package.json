{
  "name": "@cat/ui",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "format": "node ../../tooling/oxlint/run.ts format",
    "lint": "node ../../tooling/oxlint/run.ts lint",
    "test": "vitest run --reporter=agent --silent=passed-only --config vitest.config.ts",
    "test:unit": "vitest run --reporter=agent --silent=passed-only --config vitest.config.ts --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lucide/vue": "catalog:",
    "@tanstack/vue-table": "catalog:",
    "@vue-flow/controls": "catalog:",
    "@vue-flow/core": "catalog:",
    "@vue-flow/minimap": "catalog:",
    "@vueuse/core": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "elkjs": "catalog:",
    "reka-ui": "catalog:",
    "tailwind-merge": "catalog:",
    "vee-validate": "catalog:",
    "vike-vue": "catalog:",
    "vue": "catalog:",
    "vue-sonner": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "shadcn-vue": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
