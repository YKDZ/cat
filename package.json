{
  "name": "cat-root",
  "private": true,
  "type": "module",
  "scripts": {
    "boundaries": "node scripts/workspace-boundaries.ts",
    "build": "turbo run build --cache-workers=2 --remote-cache-timeout=5 --output-logs=errors-only --log-order=grouped --log-prefix=task",
    "build-plugins": "turbo run build --filter=@cat/plugin-core --filter='@cat-plugin/*' --cache-workers=2 --remote-cache-timeout=5 --output-logs=errors-only --log-order=grouped --log-prefix=task",
    "build:all": "turbo run build --cache-workers=2 --remote-cache-timeout=5 --output-logs=errors-only --log-order=grouped --log-prefix=task",
    "build:app": "turbo run build --filter=@cat/app --cache-workers=2 --remote-cache-timeout=5 --output-logs=errors-only --log-order=grouped --log-prefix=task",
    "build:application-images": "node scripts/image-family-builder.ts --family application",
    "build:e2e": "turbo run build --filter=@cat/app-e2e --cache-workers=2 --remote-cache-timeout=5 --output-logs=errors-only --log-order=grouped --log-prefix=task",
    "build:images": "node scripts/image-family-builder.ts --all",
    "build:spacy-image": "node scripts/image-family-builder.ts --family spacy",
    "check": "turbo run boundaries format:check lint typecheck test:unit codegen:check test:tooling --continue=dependencies-successful --cache-workers=2 --remote-cache-timeout=5 --output-logs=errors-only --log-order=grouped --log-prefix=task",
    "check:all": "node scripts/verification-local.ts",
    "ci:buildx-cache:finalize": "node scripts/finalize-buildx-cache.ts",
    "ci:install": "pnpm install --frozen-lockfile",
    "ci:install:playwright:chromium": "pnpm exec playwright install --with-deps chromium",
    "ci:install:playwright:release": "pnpm exec playwright install --with-deps chromium firefox",
    "ci:setup:spacy": "pnpm spacy:sync",
    "ci:verification:aggregate": "node scripts/ci-verification.ts aggregate",
    "ci:verification:plan": "node scripts/ci-verification.ts plan",
    "ci:verification:release": "node scripts/ci-verification.ts release",
    "ci:verification:run": "node scripts/ci-verification.ts run",
    "codegen:check": "node scripts/check-generated.ts",
    "container:check-dockerfile": "docker buildx build --check --progress=quiet --file apps/app/Dockerfile .",
    "container:cleanup-image-artifacts": "node scripts/image-artifacts.ts cleanup",
    "container:init-image-artifacts": "node scripts/image-artifacts.ts init",
    "container:verify-base-image": "node scripts/verify-base-image.ts",
    "dev": "node apps/app/scripts/dev.ts",
    "fix": "turbo run format:write --cache-workers=2 --remote-cache-timeout=5 --log-order=grouped --log-prefix=task && turbo run lint:fix --cache-workers=2 --remote-cache-timeout=5 --log-order=grouped --log-prefix=task",
    "format:check": "oxfmt --list-different --config oxfmt.config.ts package.json turbo.json tsconfig*.json scripts/vitest.config.ts oxlint.config.ts oxfmt.config.ts pnpm-workspace.yaml scripts tooling",
    "format:write": "oxfmt --write --config oxfmt.config.ts package.json turbo.json tsconfig*.json scripts/vitest.config.ts oxlint.config.ts oxfmt.config.ts pnpm-workspace.yaml scripts tooling",
    "lint": "oxlint --quiet --format=unix --type-aware --config oxlint.config.ts --no-error-on-unmatched-pattern scripts/vitest.config.ts oxlint.config.ts oxfmt.config.ts scripts tooling",
    "lint:fix": "oxlint --fix --format=unix --type-aware --config oxlint.config.ts --no-error-on-unmatched-pattern scripts/vitest.config.ts oxlint.config.ts oxfmt.config.ts scripts tooling",
    "seed": "node --conditions=source tools/seeder/main.ts tools/seeder/datasets/minecraft",
    "spacy:sync": "cd apps/spacy-server && uv sync --frozen",
    "test": "pnpm test:tooling",
    "test:artifacts": "pnpm build:all && pnpm test:artifacts:verify",
    "test:artifacts:verify": "vitest run scripts/package-artifacts.test.ts --config scripts/vitest.artifacts.config.ts --reporter=agent --silent=passed-only",
    "test:compose-contract": "vitest run scripts/compose-contract.test.ts --config scripts/vitest.integration.config.ts --reporter=agent --silent=passed-only",
    "test:e2e": "pnpm build:e2e && pnpm --filter @cat/app-e2e test:e2e",
    "test:image-artifact-contract": "vitest run scripts/image-artifact-contract.test.ts --config scripts/vitest.integration.config.ts --reporter=agent --silent=passed-only",
    "test:integration": "turbo run test:integration --cache-workers=2 --remote-cache-timeout=5 --output-logs=errors-only --log-order=grouped --log-prefix=task",
    "test:pglite": "node scripts/pglite-compat-gate.ts",
    "test:tooling": "vitest run --config scripts/vitest.config.ts --reporter=agent --silent=passed-only && cd apps/spacy-server && PYTHONDONTWRITEBYTECODE=1 uv run --frozen --no-sync pytest && PYTHONDONTWRITEBYTECODE=1 uv run --frozen --no-sync ruff check . && PYTHONDONTWRITEBYTECODE=1 uv run --frozen --no-sync ruff format --check . && PYTHONDONTWRITEBYTECODE=1 uv run --frozen --no-sync mypy",
    "test:unit": "turbo run test:unit --cache-workers=2 --remote-cache-timeout=5 --output-logs=errors-only --log-order=grouped --log-prefix=task",
    "typecheck": "pnpm --workspace-root exec tsc --noEmit --pretty false -p tsconfig.json"
  },
  "devDependencies": {
    "@cat/cli": "link:apps/cli",
    "@cat/domain": "link:packages/domain",
    "@cat/shared": "link:packages/shared",
    "@cat/typescript-config": "link:packages/typescript-config",
    "@electric-sql/pglite": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/ui": "catalog:",
    "@vue/test-utils": "catalog:",
    "jiti": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pino-pretty": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-mock-extended": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": "24.16.0"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
