{
  "extends": "@cat/typescript-config/node.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "scripts/**/*.js",
    "scripts/**/*.ts",
    "tooling/**/*.js",
    "tooling/**/*.ts"
  ]
}
