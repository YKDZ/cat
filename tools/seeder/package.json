  },
  "dependencies": {
    "@cat/db": "link:../../packages/db",
    "@cat/domain": "link:../../packages/domain",
    "@cat/plugin-core": "link:../../packages/plugin-core",
    "@cat/seed": "link:../../packages/seed",
    "@cat/server-shared": "link:../../packages/server-shared",
    "@cat/shared": "link:../../packages/shared"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
